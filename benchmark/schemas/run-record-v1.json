{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signallayerlabs.github.io/Marginal/schemas/codex-run-record-v1.json",
  "title": "Codex MARGINAL benchmark run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "condition",
    "repetition",
    "run_status",
    "resolved",
    "configuration_sha256",
    "patch_sha256",
    "tokens",
    "wall_time_ms",
    "tool_calls",
    "repeated_calls",
    "interventions",
    "governance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "instance_id": {"type": "string", "minLength": 1},
    "condition": {"enum": ["baseline", "marginal"]},
    "repetition": {"type": "integer", "minimum": 1},
    "run_status": {
      "enum": [
        "completed",
        "timeout",
        "codex_failed",
        "integration_failed",
        "security_failed",
        "materialization_failed",
        "verifier_failed"
      ]
    },
    "resolved": {"type": ["boolean", "null"]},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "cached_input", "output", "reasoning", "total"],
      "properties": {
        "input": {"type": ["integer", "null"], "minimum": 0},
        "cached_input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "reasoning": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "wall_time_ms": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "shell_commands": {"type": ["integer", "null"], "minimum": 0},
    "file_operations": {"type": ["integer", "null"], "minimum": 0},
    "searches": {"type": ["integer", "null"], "minimum": 0},
    "test_executions": {"type": ["integer", "null"], "minimum": 0},
    "repeated_calls": {"type": "integer", "minimum": 0},
    "files_modified": {"type": ["integer", "null"], "minimum": 0},
    "diff_lines": {"type": ["integer", "null"], "minimum": 0},
    "model_reroutes": {"type": ["integer", "null"], "minimum": 0},
    "interventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_denies", "applied_denies", "reviewed", "false_stops"],
      "properties": {
        "recommended_denies": {"type": "integer", "minimum": 0},
        "applied_denies": {"type": "integer", "minimum": 0},
        "reviewed": {"type": "integer", "minimum": 0},
        "false_stops": {"type": "integer", "minimum": 0}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "usd", "latency_ms"],
      "properties": {
        "tokens": {"type": ["integer", "null"], "minimum": 0},
        "usd": {"type": ["number", "null"], "minimum": 0},
        "latency_ms": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "error_code": {"type": ["string", "null"]}
  }
}
